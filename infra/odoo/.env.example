# Copy to .env on the VPS and fill in. .env is gitignored — never commit it.
#
# Generate both passwords with:  openssl rand -base64 24

# Postgres password for the `odoo` role.
DB_PASSWORD=

# Odoo master password. Guards database create / drop / duplicate / backup.
# Make it long and unique — this is the credential that protects the books.
ADMIN_PASSWD=

# The single database this instance serves. Must match dbfilter.
DB_NAME=prisma

# --- staging (Odoo.sh-style main/staging branches) -------------------------
# Staging database. Refreshed from production by refresh-staging.sh, which
# neutralises it (mail off, crons paused, payments to test).
STAGING_DB_NAME=prisma_staging
# Custom-addons repo. `main` deploys to production, `staging` to staging.
# Use the SSH form and give the VPS's deploy key read access.
ADDONS_REPO=git@github.com:OWNER/prisma-odoo.git

# Hostname Caddy requests a TLS certificate for. Must already resolve to this
# VPS (191.215.41.153) or the ACME challenge fails.
#   srv1910052.hstgr.cloud   works today
#   erp.prismacycling.ch     needs an A record at Hostpoint first
ODOO_HOSTNAME=srv1910052.hstgr.cloud

# Let's Encrypt expiry notices go here.
ACME_EMAIL=franco.steiner@dancingqueens.ch

# --- Supabase -> Odoo order sync (the `sync` service) ---------------------
# Only needed to run the connector; the rest of the stack starts without them.
SUPABASE_URL=https://lpqhsiuspsbubzrqjkvi.supabase.co
# Service role key — bypasses RLS, so it is server-side only, never in a build.
# Same value already set in Vercel for the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=
# An Odoo login plus an API key (Odoo: avatar -> My Profile -> Account
# Security -> New API Key). Use a dedicated integration user rather than admin,
# so the sync's access can be revoked without locking you out.
ODOO_SYNC_USER=
ODOO_SYNC_API_KEY=
